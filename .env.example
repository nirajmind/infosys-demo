# ==============================================================================
# Infosys Konnect APIOps Environment Configuration Template
# ==============================================================================
# Set these values in your repository:
# Repository Settings -> Secrets and variables -> Actions
#
# SECRETS:
#   KONNECT_TOKEN: <Your Konnect System Account Token or PAT>
#
# VARIABLES:
#   KONNECT_ADDR: https://in.api.konghq.com (or https://us.api.konghq.com)
#   KONNECT_CONTROL_PLANE_NAME: infosys-poc-cp (or client CP name)
#   SELECT_TAG: infosys-poc-managed
#   TARGET_ENV: dev
# ==============================================================================

# Konnect Authentication Token
DECK_KONNECT_TOKEN=

# Target Control Plane Name
DECK_KONNECT_CONTROL_PLANE_NAME=infosys-poc-cp

# Konnect Control Plane Base Address
# India Region: https://in.api.konghq.com
# US Region: https://us.api.konghq.com
# EU Region: https://eu.api.konghq.com
DECK_KONNECT_ADDR=https://in.api.konghq.com

# Target Environment identifier
TARGET_ENV=dev

# Tag used to isolate resources managed by this CI/CD pipeline
SELECT_TAG=infosys-poc-managed
